{
  "manifest_version": 3,
  "name": "WeChat Article Clipper",
  "version": "1.0.0",
  "description": "一键将微信公众号文章转换为 Markdown 并下载到本地",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://mp.weixin.qq.com/*",
    "https://*.qpic.cn/*",
    "https://*.qq.com/*",
    "https://*.weixin.qq.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WeChat Article Clipper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mp.weixin.qq.com/s*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
